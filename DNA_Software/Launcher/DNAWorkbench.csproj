<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DnaArchitecture Condition="'$(DnaArchitecture)' == ''">x64</DnaArchitecture>
    <TargetFramework Condition="'$(DnaArchitecture)' != 'arm64'">net48</TargetFramework>
    <TargetFramework Condition="'$(DnaArchitecture)' == 'arm64'">net481</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>$(DnaArchitecture)</PlatformTarget>
    <DefineConstants Condition="'$(DnaArchitecture)' == 'arm64'">$(DefineConstants);DNA_WINDOWS_ARM64</DefineConstants>
    <ApplicationManifest Condition="'$(DnaArchitecture)' == 'arm64'">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(DnaArchitecture)' == 'arm64'">dna.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <LangVersion>5</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>8.0-recommended</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Launcher.cs;Startup.cs;LegacyLayout.cs;Dependencies.cs;OnDemand.cs;VisualTools.cs;ModernShell.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="core-payload.zip" LogicalName="DNA.Core.zip" Condition="'$(DnaArchitecture)' != 'arm64' And Exists('core-payload.zip')" />
    <EmbeddedResource Include="core-payload-arm64.zip" LogicalName="DNA.Core.zip" Condition="'$(DnaArchitecture)' == 'arm64'" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net481" Version="1.0.3" PrivateAssets="all" Condition="'$(DnaArchitecture)' == 'arm64'" />
  </ItemGroup>
</Project>
